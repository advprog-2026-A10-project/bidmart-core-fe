<file path=".github/workflows/cd-docker.yml">
name: cd-docker

on:
  push:
    branches:
      - staging
      - main
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  docker-build-and-push:
    runs-on: ubuntu-latest
    env:
      IMAGE_NAME: ghcr.io/${{ github.repository }}
      CONTAINER_NAME: bidmart-auth-fe
      SERVICE_PORT: 80
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,prefix=sha-

      - name: Build and push image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

  deploy-ec2:
    needs: docker-build-and-push
    runs-on: ubuntu-latest
    env:
      IMAGE: ghcr.io/${{ github.repository }}:sha-${{ github.sha }}
      CONTAINER_NAME: bidmart-auth-fe
      SERVICE_PORT: 80
      EC2_HOST: ${{ secrets.EC2_HOST }}
      EC2_USER: ${{ secrets.EC2_USER }}
      EC2_SSH_KEY: ${{ secrets.EC2_SSH_KEY }}
    steps:
      - name: Check deploy prerequisites
        id: deploy_gate
        shell: bash
        run: |
          set -euo pipefail

          if [[ -n "${EC2_HOST:-}" && -n "${EC2_USER:-}" && -n "${EC2_SSH_KEY:-}" ]]; then
            echo "should_deploy=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          echo "EC2 secrets are not fully configured. Skipping deployment step."
          echo "should_deploy=false" >> "$GITHUB_OUTPUT"

      - name: Deploy on EC2 via SSH
        if: steps.deploy_gate.outputs.should_deploy == 'true'
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ env.EC2_HOST }}
          username: ${{ env.EC2_USER }}
          key: ${{ env.EC2_SSH_KEY }}
          script: |
            set -euo pipefail
            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin
            docker pull "${IMAGE}"
            if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
              docker rm -f "${CONTAINER_NAME}"
            fi
            docker run -d --restart unless-stopped \
              --name "${CONTAINER_NAME}" \
              -p "${SERVICE_PORT}:${SERVICE_PORT}" \
              "${IMAGE}"
</file>

<file path=".github/workflows/ci.yml">
name: ci

on:
  pull_request:
    branches:
      - develop
      - staging
      - main
  push:
    branches:
      - develop

permissions:
  contents: read
  pull-requests: read

jobs:
  ci:
    name: ci
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Validate trigger refs
        shell: bash
        run: |
          set -euo pipefail

          is_valid_ref() {
            [[ "$1" =~ ^[A-Za-z0-9._/-]+$ ]]
          }

          event="${GITHUB_EVENT_NAME:-}"
          if [[ -z "$event" ]]; then
            echo "Missing event name."
            exit 1
          fi

          if [[ "$event" == "pull_request" ]]; then
            base="${GITHUB_BASE_REF:-}"
            head="${GITHUB_HEAD_REF:-}"
            if [[ -z "$base" || -z "$head" ]]; then
              echo "Missing pull request refs."
              exit 1
            fi
            if ! is_valid_ref "$base" || ! is_valid_ref "$head"; then
              echo "Malformed pull request refs."
              exit 1
            fi
            if [[ "$base" == "main" && "$head" != "staging" ]]; then
              echo "Invalid branch flow to main. Only staging -> main is allowed."
              exit 1
            fi
            if [[ "$base" == "staging" && "$head" != "develop" ]]; then
              echo "Invalid branch flow to staging. Only develop -> staging is allowed."
              exit 1
            fi
          elif [[ "$event" == "push" ]]; then
            ref_name="${GITHUB_REF_NAME:-}"
            if [[ -z "$ref_name" || "$ref_name" != "develop" ]]; then
              echo "Unexpected push ref. This workflow only accepts pushes to develop."
              exit 1
            fi
            if ! is_valid_ref "$ref_name"; then
              echo "Malformed push ref."
              exit 1
            fi
          else
            echo "Unsupported event type: $event"
            exit 1
          fi

      - name: Detect pull request change scope
        id: pr_scope
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const files = await github.paginate(github.rest.pulls.listFiles, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: context.payload.pull_request.number,
              per_page: 100,
            });

            const ciOnlyPatterns = [
              /^\.github\//,
            ];

            const hasNonCiChanges = files.some((file) => {
              return !ciOnlyPatterns.some((pattern) => pattern.test(file.filename));
            });

            core.info(`PR files: ${files.length}, hasNonCiChanges=${hasNonCiChanges}`);
            core.setOutput('has_non_ci_changes', hasNonCiChanges ? 'true' : 'false');

      - name: Detect project type
        id: detect
        shell: bash
        run: |
          set -euo pipefail

          has_rust="false"
          has_node="false"
          node_manager=""
          node_lockfile=""

          if [[ -f "Cargo.toml" ]]; then
            has_rust="true"
          fi

          if [[ -f "package.json" ]]; then
            has_node="true"
            if [[ -f "pnpm-lock.yaml" ]]; then
              node_manager="pnpm"
              node_lockfile="pnpm-lock.yaml"
            elif [[ -f "yarn.lock" ]]; then
              node_manager="yarn"
              node_lockfile="yarn.lock"
            elif [[ -f "package-lock.json" ]]; then
              node_manager="npm"
              node_lockfile="package-lock.json"
            elif [[ -f "npm-shrinkwrap.json" ]]; then
              node_manager="npm"
              node_lockfile="npm-shrinkwrap.json"
            else
              echo "package.json found, but no supported lockfile is present."
              exit 1
            fi
          fi

          if [[ "$has_rust" == "false" && "$has_node" == "false" ]]; then
            echo "No supported pipeline detected. Expected Cargo.toml or package.json."
            exit 1
          fi

          {
            echo "has_rust=$has_rust"
            echo "has_node=$has_node"
            echo "node_manager=$node_manager"
            echo "node_lockfile=$node_lockfile"
          } >> "$GITHUB_OUTPUT"

      - name: Set up Rust toolchain
        if: steps.detect.outputs.has_rust == 'true'
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - name: Cache Rust dependencies
        if: steps.detect.outputs.has_rust == 'true'
        uses: Swatinem/rust-cache@v2

      - name: Rust checks
        if: steps.detect.outputs.has_rust == 'true'
        shell: bash
        run: |
          set -euo pipefail
          cargo fmt --all -- --check
          cargo clippy --all-targets --all-features -- -D warnings
          cargo test --all --all-features

      - name: Install cargo-audit
        if: steps.detect.outputs.has_rust == 'true' && github.event_name == 'pull_request' && steps.pr_scope.outputs.has_non_ci_changes == 'true' && (github.base_ref == 'staging' || github.base_ref == 'main')
        shell: bash
        run: |
          set -euo pipefail
          cargo install cargo-audit --locked

      - name: Rust security audit
        if: steps.detect.outputs.has_rust == 'true' && github.event_name == 'pull_request' && steps.pr_scope.outputs.has_non_ci_changes == 'true' && (github.base_ref == 'staging' || github.base_ref == 'main')
        shell: bash
        run: |
          set -euo pipefail
          cargo audit

      - name: Set up Node.js (npm with cache)
        if: steps.detect.outputs.has_node == 'true' && steps.detect.outputs.node_manager == 'npm'
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: ${{ steps.detect.outputs.node_lockfile }}

      - name: Set up Node.js (pnpm/yarn)
        if: steps.detect.outputs.has_node == 'true' && steps.detect.outputs.node_manager != 'npm'
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Enable Corepack
        if: steps.detect.outputs.has_node == 'true' && (steps.detect.outputs.node_manager == 'pnpm' || steps.detect.outputs.node_manager == 'yarn')
        shell: bash
        run: |
          set -euo pipefail
          corepack enable

      - name: Install Node dependencies
        if: steps.detect.outputs.has_node == 'true'
        shell: bash
        run: |
          set -euo pipefail

          manager="${{ steps.detect.outputs.node_manager }}"
          case "$manager" in
            npm)
              npm ci
              ;;
            pnpm)
              pnpm install --frozen-lockfile
              ;;
            yarn)
              yarn install --frozen-lockfile
              ;;
            *)
              echo "Unsupported package manager: $manager"
              exit 1
              ;;
          esac

      - name: Node checks
        if: steps.detect.outputs.has_node == 'true'
        shell: bash
        run: |
          set -euo pipefail

          manager="${{ steps.detect.outputs.node_manager }}"

          run_script_if_present() {
            local script_name="$1"
            if node -e "const pkg=require('./package.json');process.exit(pkg.scripts && Object.prototype.hasOwnProperty.call(pkg.scripts, '$script_name') ? 0 : 1)"; then
              case "$manager" in
                npm)
                  npm run "$script_name"
                  ;;
                pnpm)
                  pnpm run "$script_name"
                  ;;
                yarn)
                  yarn "$script_name"
                  ;;
              esac
            else
              echo "Skipping '$script_name' (script not present)."
            fi
          }

          run_script_if_present "lint"

          if node -e "const pkg=require('./package.json');process.exit(pkg.scripts && Object.prototype.hasOwnProperty.call(pkg.scripts, 'format:check') ? 0 : 1)"; then
            run_script_if_present "format:check"
          elif node -e "const p=require('./package.json'); const d=Object.assign({}, p.dependencies || {}, p.devDependencies || {}); process.exit(Object.prototype.hasOwnProperty.call(d, 'prettier') ? 0 : 1)"; then
            case "$manager" in
              npm)
                npx --no-install prettier --check .
                ;;
              pnpm)
                pnpm exec prettier --check .
                ;;
              yarn)
                yarn prettier --check .
                ;;
            esac
          else
            echo "Skipping format check (no format:check script or prettier dependency)."
          fi

          run_script_if_present "test"

      - name: Node security audit
        if: steps.detect.outputs.has_node == 'true' && github.event_name == 'pull_request' && steps.pr_scope.outputs.has_non_ci_changes == 'true' && (github.base_ref == 'staging' || github.base_ref == 'main')
        shell: bash
        run: |
          set -euo pipefail

          manager="${{ steps.detect.outputs.node_manager }}"
          case "$manager" in
            npm)
              npm audit --audit-level=high
              ;;
            pnpm)
              pnpm audit --audit-level high
              ;;
            yarn)
              yarn_major="$(yarn --version | cut -d. -f1)"
              if [[ "$yarn_major" -ge 2 ]]; then
                yarn npm audit --severity high
              else
                yarn audit --level high
              fi
              ;;
            *)
              echo "Unsupported package manager for audit: $manager"
              exit 1
              ;;
          esac
</file>

